{
  "info": {
    "_postman_id": "f36a9e65-3a8d-49fa-8d51-2dbbf5f8b7a2",
    "name": "Alacena Nutrition",
    "description": "Pruebas para registro con datos nutricionales, cálculo de metas y perfil de nutrición.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register admin (with nutrition inputs)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('admin_email', 'admin.' + Date.now() + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response has access_token', function () {",
                  "  pm.expect(jsonData).to.have.property('access_token');",
                  "});",
                  "if (jsonData.access_token) {",
                  "  pm.environment.set('jwt_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "  pm.environment.set('user_id', jsonData.user.id);",
                  "}",
                  "pm.test('Response has user fields', function () {",
                  "  pm.expect(jsonData.user).to.have.property('email');",
                  "  pm.expect(jsonData.user).to.have.property('first_name');",
                  "  pm.expect(jsonData.user).to.have.property('last_name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Admin\",\n  \"last_name\": \"Nutrition\",\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\",\n  \"birth_date\": \"1990-01-01\",\n  \"sex\": \"hombre\",\n  \"weight_kg\": 80,\n  \"height_cm\": 180,\n  \"activity_level\": \"moderado\",\n  \"goal\": \"mantener\",\n  \"diet_type\": \"omnivore\",\n  \"excluded_ingredients\": [\"mani\"],\n  \"excluded_categories\": [\"lacteo\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response has access_token', function () {",
                  "  pm.expect(jsonData).to.have.property('access_token');",
                  "});",
                  "if (jsonData.access_token) {",
                  "  pm.environment.set('jwt_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "  pm.environment.set('user_id', jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response has email', function () {",
                  "  pm.expect(jsonData).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Update user nutrition inputs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response has updated fields', function () {",
                  "  pm.expect(jsonData).to.have.property('weightKg');",
                  "  pm.expect(jsonData).to.have.property('heightCm');",
                  "  pm.expect(jsonData).to.have.property('activityLevel');",
                  "  pm.expect(jsonData).to.have.property('goalDailyCalories');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weightKg\": 78,\n  \"heightCm\": 180,\n  \"activityLevel\": \"activo\",\n  \"goal\": \"bajar\",\n  \"dietType\": \"vegetarian\",\n  \"excludedIngredients\": [\"pescado\"],\n  \"excludedCategories\": [\"mariscos\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{user_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Nutrition",
      "item": [
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Profile has calculated targets', function () {",
                  "  pm.expect(jsonData).to.have.property('maxDailyCalories');",
                  "  pm.expect(jsonData).to.have.property('targetProtein');",
                  "  pm.expect(jsonData).to.have.property('targetCarbs');",
                  "  pm.expect(jsonData).to.have.property('targetFat');",
                  "  pm.expect(jsonData.maxDailyCalories).to.be.a('number');",
                  "});",
                  "pm.test('Profile has preferences', function () {",
                  "  pm.expect(jsonData).to.have.property('dietType');",
                  "  pm.expect(jsonData).to.have.property('excludedIngredients');",
                  "  pm.expect(jsonData).to.have.property('excludedCategories');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/profile",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "profile"]
            }
          }
        }
      ]
    }
  ]
}
