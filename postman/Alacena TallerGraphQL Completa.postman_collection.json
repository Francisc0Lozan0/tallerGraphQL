    "description": "Colección REST y GraphQL para probar el proyecto Alacena. Ejecuta primero Setup > Reset runtime variables y luego Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"runSuffix\")) {",
          "  const suffix = Date.now().toString();",
          "  pm.environment.set(\"runSuffix\", suffix);",
          "  pm.environment.set(\"adminEmail\", `admin.${suffix}@example.com`);",
          "  pm.environment.set(\"userEmail\", `user.${suffix}@example.com`);",
          "}",
          "if (!pm.environment.get(\"password\")) {",
          "  pm.environment.set(\"password\", \"Admin123!\");",
          "}",
          "const future = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();",
          "pm.environment.set(\"futureDate\", future);",
          "pm.environment.set(\"today\", new Date().toISOString().slice(0, 10));"
        ]
      }
    }
  ],
