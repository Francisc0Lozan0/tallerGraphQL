                  "const suffix = Date.now().toString();",
                  "pm.environment.set(\"runSuffix\", suffix);",
                  "pm.environment.set(\"adminEmail\", `admin.${suffix}@example.com`);",
                  "pm.environment.set(\"userEmail\", `user.${suffix}@example.com`);",
                  "pm.environment.set(\"password\", \"Admin123!\");",
                  "[\"access_token\", \"admin_access_token\", \"user_id\", \"admin_user_id\", \"product_id\", \"inventory_item_id\", \"recipe_id\", \"tracker_id\", \"goal_id\", \"notification_id\", \"store_id\", \"recommendation_feedback_id\"].forEach((key) => pm.environment.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
