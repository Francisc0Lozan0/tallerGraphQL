{
  "info": {
    "_postman_id": "7b4b2b5a-4b1b-4b7d-a3d8-0c77f6d8c9d1",
    "name": "Alacena API",
    "description": "Colección para probar el registro de usuarios con JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has access_token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Santiago\",\n  \"last_name\": \"Lopez\",\n  \"email\": \"pezsan0512@gmail.com\",\n  \"password\": \"123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registra un usuario nuevo con nombre, correo y contraseña."
          },
          "response": []
        },
        {
          "name": "Login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has access_token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    if(jsonData.access_token) {",
                  "        pm.environment.set(\"jwt_token\", jsonData.access_token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pezsan0512@gmail.com\",\n  \"password\": \"123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión con un usuario existente devolviendo un Token JWT."
          },
          "response": []
        },
        {
          "name": "Logout user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.environment.unset(\"jwt_token\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Cierra sesión invalidando o borrando el token JWT del cliente."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Nutrition",
      "item": [
        {
          "name": "Get my profile (unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/nutrition/profile",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "profile"]
            },
            "description": "Debe rechazar el acceso sin JWT."
          },
          "response": []
        },
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"JWT token exists in environment\", function () {",
                  "    pm.expect(pm.environment.get('jwt_token')).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response has nutrition profile shape\", function () {",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('userId');",
                  "    pm.expect(jsonData).to.have.property('dietType');",
                  "    pm.expect(jsonData).to.have.property('excludedIngredients');",
                  "    pm.expect(jsonData).to.have.property('excludedCategories');",
                  "    pm.expect(jsonData.excludedIngredients).to.be.an('array');",
                  "    pm.expect(jsonData.excludedCategories).to.be.an('array');",
                  "    pm.expect(['omnivore', 'vegetarian', 'vegan']).to.include(jsonData.dietType);",
                  "});",
                  "",
                  "if (jsonData && jsonData.id) {",
                  "    pm.environment.set('nutrition_profile_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/profile",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "profile"]
            },
            "description": "Obtiene el perfil nutricional del usuario autenticado."
          },
          "response": []
        },
        {
          "name": "Upsert my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"JWT token exists in environment\", function () {",
                  "    pm.expect(pm.environment.get('jwt_token')).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Profile values were updated\", function () {",
                  "    pm.expect(jsonData.dietType).to.eql('vegetarian');",
                  "    pm.expect(jsonData.excludedIngredients).to.include('mani');",
                  "    pm.expect(jsonData.excludedCategories).to.include('lacteo');",
                  "    pm.expect(jsonData.maxDailyCalories).to.eql(2200);",
                  "    pm.expect(jsonData.targetProtein).to.eql(140);",
                  "    pm.expect(jsonData.targetCarbs).to.eql(220);",
                  "    pm.expect(jsonData.targetFat).to.eql(70);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dietType\": \"vegetarian\",\n  \"excludedIngredients\": [\"mani\", \"pescado\"],\n  \"excludedCategories\": [\"lacteo\"],\n  \"maxDailyCalories\": 2200,\n  \"targetProtein\": 140,\n  \"targetCarbs\": 220,\n  \"targetFat\": 70\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/nutrition/profile",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "profile"]
            },
            "description": "Crea o actualiza el perfil nutricional del usuario autenticado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
